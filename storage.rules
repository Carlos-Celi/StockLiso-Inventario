rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Comprobantes de ventas (OWASP A03 / A04 - Validación de tipos MIME y tamaño)
    match /comprobantes/{ventaId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size <= 5 * 1024 * 1024 // max 5 MB
                   && request.resource.contentType in ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
    }
  }
}
